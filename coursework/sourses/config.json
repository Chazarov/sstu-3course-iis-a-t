{
  "система": {
    "название": "Экспертная система подбора классической литературы",
    "версия": "1.0",
    "автор": "Студент Политеха",
    "дата_создания": "2024",
    "описание": "Система рекомендации книг русской классической литературы на основе предпочтений читателя"
  },

  "структура_данных": {
    "книги": {
      "путь": "parametrs/",
      "формат": "JSON",
      "количество": 23
    },
    "фреймы": {
      "путь": "frames/",
      "файлы": ["авторы.json", "жанры.json", "направления.json"]
    },
    "правила": {
      "путь": "rules/правила.json",
      "количество_правил": 35
    },
    "вопросы": {
      "путь": "data/вопросы.json",
      "количество_вопросов": 9
    },
    "каталог": {
      "путь": "data/каталог.json"
    }
  },

  "параметры_системы": {
    "минимум_совпадений_для_рекомендации": 2,
    "максимум_рекомендаций": 5,
    "показывать_объяснение": true,
    "режим_интриги": true
  },

  "категории": {
    "объём": {
      "короткое": {"мин": 0, "макс": 200},
