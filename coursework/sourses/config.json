    "эпоха": ["начало_XIX", "середина_XIX", "конец_XIX", "начало_XX", "советский_период"],
    "направление": ["романтизм", "реализм", "сатира", "модернизм"],
    "жанр": ["роман", "повесть", "поэма", "пьеса", "рассказы", "роман_в_стихах", "эпопея"],
    "тип_конфликта": ["личность_vs_общество", "добро_vs_зло", "долг_vs_чувство", "идеал_vs_реальность", "старое_vs_новое", "свобода_vs_система"],
    "тип_героя": ["идеалист", "бунтарь", "лишний_человек", "обыватель", "искатель", "жертва", "антигерой"],
    "темы": ["любовь", "война", "свобода", "вера", "общество", "власть", "семья", "смерть", "искусство", "природа", "честь", "нигилизм", "революция"],
    "художественные_средства": ["психологизм", "символизм", "ирония", "лиризм", "реализм", "фантастика", "гротеск", "диалоги", "монологи", "пейзажи", "фольклор", "аллюзии", "метафоры", "сатира", "автобиографизм"]
  },

  "статистика": {
